doctype html
html
  head
    meta(charset="UTF-8")
    title You're subscribed to TechNest
    style.
      body { font-family: Arial, sans-serif; background: #f4f6f9; margin: 0; padding: 0; }
      .wrapper { max-width: 560px; margin: 40px auto; background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
      .header { background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%); padding: 36px 40px; text-align: center; }
      .header h1 { color: #ffffff; margin: 0; font-size: 24px; font-weight: 700; }
      .header p  { color: #bfdbfe; margin: 6px 0 0; font-size: 14px; }
      .body { padding: 36px 40px; }
      .body h2 { color: #0f172a; font-size: 20px; margin: 0 0 12px; }
      .body p  { color: #475569; font-size: 15px; line-height: 1.7; margin: 0 0 16px; }
      .promo { background: linear-gradient(135deg, #eff6ff, #dbeafe); border: 1px solid #bfdbfe; border-radius: 12px; padding: 24px; text-align: center; margin: 20px 0; }
      .promo .code { font-size: 28px; font-weight: 800; letter-spacing: 4px; color: #1d4ed8; margin: 8px 0; }
      .promo p { color: #3b82f6; font-size: 13px; margin: 0; }
      .btn { display: inline-block; background: #2563eb; color: #ffffff !important; text-decoration: none; padding: 14px 32px; border-radius: 10px; font-weight: 700; font-size: 15px; margin: 8px 0 24px; }
      .footer { background: #f8fafc; border-top: 1px solid #e2e8f0; padding: 20px 40px; text-align: center; }
      .footer p { color: #94a3b8; font-size: 12px; margin: 0; line-height: 1.6; }
  body
    .wrapper
      .header
        h1 📦 TechNest
        p Premium Tech Accessories

      .body
        h2 You're officially subscribed! 🎉
        p Thanks for joining the TechNest community. As promised, here's your exclusive 10% off promo code for your first order:

        .promo
          p Your discount code
          .code NEST10
          p Use at checkout — valid for 30 days

        a.btn(href=url) Shop Now →

        p You'll be the first to hear about new arrivals, flash deals, and member-only bundles. We promise no spam — just the good stuff.

      .footer
        p © 2026 TechNest. All rights reserved.
        p
          | Don't want these emails?&nbsp;
          a(href="#" style="color:#94a3b8") Unsubscribe
